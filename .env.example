# Provider mode:
# - auto: use Gemini or Groq when a key exists; otherwise use extractive fallback.
# - gemini: force Gemini.
# - groq: force Groq.
# - extractive: never call an LLM; return grounded retrieved snippets.
LLM_PROVIDER=auto

# Optional LLM keys. Do not commit real keys.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Prevent slow provider calls from freezing the UI.
LLM_TIMEOUT_SECONDS=20

# Embedding model. First run downloads the model from Hugging Face.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Retrieval and confidence tuning.
TOP_K=5
VECTOR_POOL_MULTIPLIER=4
VECTOR_WEIGHT=0.72
KEYWORD_WEIGHT=0.28
CONFIDENCE_THRESHOLD=0.35

# Token-aware chunking.
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Paths.
PAPERS_DIR=./papers
CHROMA_DIR=./chroma_db
